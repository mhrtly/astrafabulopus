#!/usr/bin/env python3
# astrafabulopus: af-statusline. Standard library only; Python 3.9+.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from astrafab import statusline  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(statusline.main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
