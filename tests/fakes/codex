#!/usr/bin/env python3
"""A fake Codex CLI for the test suite. It mimics the parts of codex 0.157 the lanes rely on: the
exec header with `session id:`, --output-last-message, rollout files with token_count/rate_limits,
`codex login status`, and clap's refusal to combine `review --uncommitted` with a prompt.

Behaviour is steered by environment variables:
  FAKE_CODEX_MODE      write (default) | noop | fail | sleep | edit-untracked | edit-modified | revert | commit | solve
  FAKE_CODEX_FILE      file to create or edit, relative to --cd (default created-by-fake.txt)
  FAKE_CODEX_LOGGED_IN 1 (default) or 0
  FAKE_CODEX_USED5H / FAKE_CODEX_USED7D   used_percent to report (default 12.5 / 3.0)
  FAKE_CODEX_RESET5H / FAKE_CODEX_RESET7D  resets_at epoch seconds (default now+2h / now+4d)
  FAKE_CODEX_NO_RATES  1 = write token_count without rate_limits
  FAKE_CODEX_REACHED   a rate_limit_reached_type to report (e.g. rate_limit_reached)
  FAKE_CODEX_CREDITS   report purchased credits with this balance
  FAKE_CODEX_ARGS_LOG  append each invocation's argv (JSON) here
  FAKE_CODEX_REJECT_EFFORT  an effort to reject like an unsupported model would
"""
import datetime as dt
import json
import os
import sys
import time
import uuid

argv = sys.argv[1:]
if os.environ.get("FAKE_CODEX_ARGS_LOG"):
    with open(os.environ["FAKE_CODEX_ARGS_LOG"], "a") as fh:
        fh.write(json.dumps(argv) + "\n")

if argv[:2] == ["login", "status"]:
    if os.environ.get("FAKE_CODEX_LOGGED_IN", "1") == "1":
        print("Logged in using ChatGPT")
        sys.exit(0)
    print("Not logged in")
    sys.exit(1)
if argv[:1] == ["--version"]:
    print("codex-cli 0.157.1 (fake)")
    sys.exit(0)
if argv[:1] != ["exec"]:
    sys.stderr.write("fake codex: unsupported invocation %r\n" % argv)
    sys.exit(2)

args = argv[1:]
opts = {"model": "gpt-5.5", "cd": os.getcwd(), "out": None, "sandbox": None, "effort": None}
positional, i = [], 0
takes_value = {"-m": "model", "--model": "model", "--cd": "cd", "-C": "cd", "-o": "out",
               "--output-last-message": "out", "--sandbox": "sandbox", "-s": "sandbox",
               "--local-provider": "local"}
review, review_flags = False, []
while i < len(args):
    a = args[i]
    if a in takes_value:
        opts[takes_value[a]] = args[i + 1]
        i += 2
        continue
    if a == "-c":
        k, _, v = args[i + 1].partition("=")
        if k == "model_reasoning_effort":
            opts["effort"] = v
        i += 2
        continue
    if a in ("--skip-git-repo-check", "--oss", "--ephemeral", "--json"):
        i += 1
        continue
    if a == "review" and not review:
        review = True
        i += 1
        continue
    if review and a in ("--uncommitted",):
        review_flags.append(a)
        i += 1
        continue
    if review and a in ("--base", "--commit"):
        review_flags += [a, args[i + 1]]
        i += 2
        continue
    positional.append(a)
    i += 1

if review and review_flags and positional:
    sys.stderr.write("error: the argument '%s' cannot be used with '[PROMPT]'\n" % review_flags[0])
    sys.exit(2)

prompt = sys.stdin.read() if positional[-1:] == ["-"] or (not positional and not review_flags) else " ".join(positional)
sid = str(uuid.uuid4())
print("OpenAI Codex v0.157.1 (fake)\n--------\nworkdir: %s\nmodel: %s\nsandbox: %s\nreasoning effort: %s\nsession id: %s\n--------"
      % (opts["cd"], opts["model"], opts["sandbox"], opts["effort"], sid))
sys.stdout.flush()

if os.environ.get("FAKE_CODEX_REJECT_EFFORT") and opts["effort"] == os.environ["FAKE_CODEX_REJECT_EFFORT"]:
    print("ERROR: unsupported reasoning effort '%s' for %s" % (opts["effort"], opts["model"]))
    sys.exit(1)

mode = os.environ.get("FAKE_CODEX_MODE", "write")
target = os.path.join(opts["cd"], os.environ.get("FAKE_CODEX_FILE", "created-by-fake.txt"))
final = "Did the thing. Verification: 1 passed."
rc = 0
if mode == "sleep":
    time.sleep(float(os.environ.get("FAKE_CODEX_SLEEP", "30")))
elif mode == "fail":
    print("ERROR: stream disconnected before completion")
    rc = 1
    final = ""
elif mode == "noop":
    final = "I looked around and decided not to change anything."
elif opts["sandbox"] == "read-only":
    final = "VERDICT: ship\nREASON: fake reviewer is easily pleased\nFINDINGS: none\nRESIDUAL RISK: none"
elif mode in ("write", "edit-untracked", "edit-modified"):
    with open(target, "a") as fh:
        fh.write("spud %s\n" % sid)
elif mode == "commit":  # a lane that ignores "do not commit"
    with open(target, "a") as fh:
        fh.write("committed spud %s\n" % sid)
    os.system("git -C '%s' add -A >/dev/null 2>&1 && git -C '%s' -c user.name=f -c user.email=f@f commit -qm fake >/dev/null 2>&1"
              % (opts["cd"], opts["cd"]))
elif mode == "revert":
    os.system("git -C '%s' checkout -- . >/dev/null 2>&1" % opts["cd"])
elif mode == "solve":  # the tryout fixture's reference solutions, so af-tryout's happy path is testable
    lib = os.path.join(opts["cd"], "spudlib")
    if "count_eyes" in prompt:
        with open(os.path.join(lib, "eyes.py"), "w") as fh:
            fh.write("def count_eyes(text):\n    n, prev = 0, False\n    for ch in text:\n"
                     "        cur = ch in 'oO'\n        if cur and not prev:\n            n += 1\n"
                     "        prev = cur\n    return n\n")
    elif "chunk" in prompt:
        p = os.path.join(lib, "mash.py")
        src = open(p).read().replace("len(items) - size, size", "len(items), size")
        open(p, "w").write(src)
    elif "fair_split" in prompt:
        with open(os.path.join(lib, "pantry.py"), "w") as fh:
            fh.write("def fair_split(total_cents, weights):\n"
                     "    if total_cents < 0 or not weights or any(w < 0 for w in weights) or not any(weights):\n"
                     "        raise ValueError('bad input')\n"
                     "    W = sum(weights)\n    base = [total_cents * w // W for w in weights]\n"
                     "    rem = [(total_cents * w) % W for w in weights]\n    left = total_cents - sum(base)\n"
                     "    for i in sorted(range(len(weights)), key=lambda i: (-rem[i], i))[:left]:\n"
                     "        base[i] += 1\n    return base\n")

now = time.time()
home = os.path.expanduser(os.environ.get("CODEX_HOME") or "~/.codex")
day = dt.datetime.now()
folder = os.path.join(home, "sessions", day.strftime("%Y"), day.strftime("%m"), day.strftime("%d"))
os.makedirs(folder, exist_ok=True)
path = os.path.join(folder, "rollout-%s-%s.jsonl" % (day.strftime("%Y-%m-%dT%H-%M-%S"), sid))
stamp = dt.datetime.fromtimestamp(now, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
payload = {"type": "token_count",
           "info": {"total_token_usage": {"input_tokens": 12000, "cached_input_tokens": 8000,
                                          "output_tokens": 900, "reasoning_output_tokens": 400,
                                          "total_tokens": 12900},
                    "last_token_usage": {}, "model_context_window": 258400}}
if os.environ.get("FAKE_CODEX_NO_RATES") != "1":
    payload["rate_limits"] = {
        "limit_id": "codex", "limit_name": None,
        "primary": {"used_percent": float(os.environ.get("FAKE_CODEX_USED5H", "12.5")), "window_minutes": 300,
                    "resets_at": int(float(os.environ.get("FAKE_CODEX_RESET5H", now + 7200)))},
        "secondary": {"used_percent": float(os.environ.get("FAKE_CODEX_USED7D", "3.0")), "window_minutes": 10080,
                      "resets_at": int(float(os.environ.get("FAKE_CODEX_RESET7D", now + 4 * 86400)))},
        "credits": {"has_credits": False, "unlimited": False, "balance": None},
        "individual_limit": None, "spend_control_reached": None, "plan_type": "plus",
        "rate_limit_reached_type": os.environ.get("FAKE_CODEX_REACHED") or None}
    if os.environ.get("FAKE_CODEX_CREDITS"):
        payload["rate_limits"]["credits"] = {"has_credits": True, "unlimited": False,
                                             "balance": os.environ["FAKE_CODEX_CREDITS"]}
with open(path, "w") as fh:
    fh.write(json.dumps({"timestamp": stamp, "type": "session_meta",
                         "payload": {"session_id": sid, "id": sid, "originator": "codex_exec"}}) + "\n")
    fh.write(json.dumps({"timestamp": stamp, "type": "event_msg", "payload": payload}) + "\n")

if opts["out"] and final:
    with open(opts["out"], "w") as fh:
        fh.write(final + "\n")
sys.exit(rc)
